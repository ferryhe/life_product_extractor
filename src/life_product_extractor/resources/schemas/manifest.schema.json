{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/manifest.schema.json",
  "title": "Curated Markdown Fixture Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_set_id",
    "source_catalog",
    "generated_by",
    "documents",
    "paired_source_scenarios"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "fixture_set_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 1
    },
    "source_catalog": {
      "type": "object",
      "required": ["source", "source_type"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["bundled_resource", "filesystem_path"] }
      },
      "additionalProperties": false
    },
    "generated_by": {
      "type": "object",
      "required": ["tool", "version"],
      "properties": {
        "tool": { "const": "life_product_extractor.fixture_builder" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    },
    "paired_source_scenarios": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {
          "relation": { "enum": ["known_overlap", "potentially_contradictory"] }
        },
        "required": ["relation"]
      },
      "items": { "$ref": "#/$defs/pairedSourceScenario" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "secondaryTag": {
      "type": "string",
      "enum": [
        "accident",
        "adjacent_investment_context",
        "combination_product",
        "critical_illness",
        "deferred_annuity_adjacent",
        "direct_to_consumer",
        "disability",
        "disability_adjacent",
        "dividend",
        "educational_context",
        "gic_adjacent",
        "guaranteed_issue",
        "investment_account_table",
        "investment_contract",
        "long_term_care",
        "mirror_discovery_only",
        "permanent_life",
        "segregated_fund_adjacent",
        "simplified_issue",
        "supporting_table",
        "term_life",
        "universal_life",
        "vitality",
        "whole_life"
      ]
    },
    "document": {
      "type": "object",
      "required": [
        "fixture_id",
        "source_catalog_id",
        "product_name",
        "region_family",
        "jurisdiction",
        "product_class_primary",
        "product_class_secondary",
        "document_role",
        "authority_level",
        "source_url",
        "retrieval_date",
        "source_type",
        "markdown_path",
        "sha256",
        "byte_count",
        "provenance"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1
        },
        "source_catalog_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1
        },
        "product_name": { "type": "string", "minLength": 1 },
        "region_family": { "enum": ["north_america"] },
        "jurisdiction": { "enum": ["CA"] },
        "product_class_primary": {
          "enum": [
            "traditional_life",
            "ltc_di",
            "ul_iul",
            "deferred_annuity",
            "immediate_annuity",
            "multi_state",
            "participating_life",
            "other"
          ]
        },
        "product_class_secondary": {
          "type": "array",
          "items": { "$ref": "#/$defs/secondaryTag" }
        },
        "document_role": {
          "enum": [
            "adjacent_context",
            "client_guide",
            "educational_page",
            "investment_account_table",
            "mirror_discovery_only",
            "product_guide",
            "product_marketing_page"
          ]
        },
        "authority_level": {
          "enum": [
            "official_advisor",
            "official_investment_affiliate",
            "official_public",
            "third_party_mirror",
            "unknown"
          ]
        },
        "source_url": { "type": "string", "format": "uri" },
        "retrieval_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source_type": {
          "enum": ["api_table_excerpt", "html_page_excerpt", "pdf_excerpt"]
        },
        "markdown_path": { "type": "string", "pattern": "^documents\\/.+\\.md$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byte_count": { "type": "integer", "minimum": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_kind",
        "normalization",
        "raw_text_sha256",
        "raw_line_count",
        "selected_line_numbers",
        "omitted_line_ranges",
        "selected_block_count"
      ],
      "properties": {
        "source_kind": { "const": "committed_curated_snippet" },
        "normalization": { "const": "curated_markdown_excerpt_v1" },
        "raw_text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "raw_line_count": { "type": "integer", "minimum": 1 },
        "selected_line_numbers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "omitted_line_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "integer", "minimum": 1 },
              "end": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "selected_block_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "pairedSourceScenario": {
      "type": "object",
      "required": [
        "scenario_id",
        "product_name",
        "relation",
        "fixture_ids",
        "source_catalog_ids",
        "rationale"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1
        },
        "product_name": { "type": "string", "minLength": 1 },
        "relation": {
          "enum": ["complementary", "known_overlap", "potentially_contradictory"]
        },
        "fixture_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_catalog_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
