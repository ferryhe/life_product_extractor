{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/sections_structured.schema.json",
  "title": "StructuredSectionsDocument",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_set_id",
    "document_id",
    "source_catalog_id",
    "product_name",
    "document_role",
    "source_type",
    "source_url",
    "markdown_path",
    "sectionization_strategy",
    "source_provenance",
    "sections",
    "table_artifacts"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "fixture_set_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 1
    },
    "source_catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 1
    },
    "product_name": { "type": "string", "minLength": 1 },
    "document_role": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "markdown_path": {
      "type": "string",
      "pattern": "^documents\\/.+\\.md$"
    },
    "sectionization_strategy": {
      "type": "object",
      "required": [
        "deterministic",
        "html_escaped_quotes",
        "low_value_labeling",
        "table_artifacts_enabled"
      ],
      "properties": {
        "deterministic": { "const": true },
        "html_escaped_quotes": { "const": true },
        "low_value_labeling": { "const": true },
        "table_artifacts_enabled": { "const": true }
      },
      "additionalProperties": false
    },
    "source_provenance": {
      "type": "object",
      "required": ["raw_line_count", "selected_line_numbers", "omitted_line_ranges"],
      "properties": {
        "raw_line_count": { "type": "integer", "minimum": 1 },
        "selected_line_numbers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "omitted_line_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "integer", "minimum": 1 },
              "end": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    },
    "table_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/tableArtifact" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "heading": {
      "type": "object",
      "required": ["text", "level"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 0, "maximum": 6 }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "section_id",
        "heading",
        "heading_path",
        "line_start",
        "line_end",
        "body_line_start",
        "body_line_end",
        "content_types",
        "labels",
        "table_artifact_ids",
        "source_quote"
      ],
      "properties": {
        "section_id": { "type": "string", "minLength": 1 },
        "heading": { "$ref": "#/$defs/heading" },
        "heading_path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "body_line_start": { "type": "integer", "minimum": 1 },
        "body_line_end": { "type": "integer", "minimum": 1 },
        "content_types": {
          "type": "array",
          "items": {
            "enum": ["paragraph", "bullet_list", "table"]
          },
          "uniqueItems": true
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["primary_content", "contains_low_value_lines", "low_value"]
          },
          "uniqueItems": true
        },
        "table_artifact_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_quote": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            { "not": { "pattern": "[<>]" } }
          ]
        }
      },
      "additionalProperties": false
    },
    "tableArtifact": {
      "type": "object",
      "required": [
        "table_id",
        "section_id",
        "artifact_type",
        "line_start",
        "line_end",
        "source_quote",
        "rows"
      ],
      "properties": {
        "table_id": { "type": "string", "minLength": 1 },
        "section_id": { "type": "string", "minLength": 1 },
        "artifact_type": {
          "enum": ["markdown_table", "bullet_list_table"]
        },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "source_quote": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            { "not": { "pattern": "[<>]" } }
          ]
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
