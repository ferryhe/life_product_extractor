{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/routing.schema.json",
  "title": "Routing",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_set_id",
    "source_catalog",
    "routing_strategy",
    "summary",
    "documents",
    "paired_source_scenarios"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "fixture_set_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 1
    },
    "source_catalog": {
      "type": "object",
      "required": ["source", "source_type"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["bundled_resource", "filesystem_path"] }
      },
      "additionalProperties": false
    },
    "routing_strategy": {
      "type": "object",
      "required": ["deterministic", "manifest_taxonomy_precedence", "taxonomy_sources_in_order"],
      "properties": {
        "deterministic": { "const": true },
        "manifest_taxonomy_precedence": { "const": true },
        "taxonomy_sources_in_order": {
          "type": "array",
          "prefixItems": [
            { "const": "manifest_document" },
            { "const": "source_catalog" },
            { "const": "content_keywords" }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["document_count", "scenario_count", "primary_class_counts"],
      "properties": {
        "document_count": { "type": "integer", "minimum": 1 },
        "scenario_count": { "type": "integer", "minimum": 1 },
        "primary_class_counts": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "traditional_life",
              "ltc_di",
              "ul_iul",
              "deferred_annuity",
              "immediate_annuity",
              "multi_state",
              "participating_life",
              "other"
            ]
          },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/documentRoute" }
    },
    "paired_source_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pairedSourceScenarioRoute" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "primaryClass": {
      "type": "string",
      "enum": [
        "traditional_life",
        "ltc_di",
        "ul_iul",
        "deferred_annuity",
        "immediate_annuity",
        "multi_state",
        "participating_life",
        "other"
      ]
    },
    "secondaryTag": {
      "type": "string",
      "enum": [
        "accident",
        "adjacent_investment_context",
        "combination_product",
        "critical_illness",
        "deferred_annuity_adjacent",
        "direct_to_consumer",
        "disability",
        "disability_adjacent",
        "dividend",
        "educational_context",
        "gic_adjacent",
        "guaranteed_issue",
        "investment_account_table",
        "investment_contract",
        "long_term_care",
        "mirror_discovery_only",
        "permanent_life",
        "segregated_fund_adjacent",
        "simplified_issue",
        "supporting_table",
        "term_life",
        "universal_life",
        "vitality",
        "whole_life"
      ]
    },
    "routingFlag": {
      "type": "string",
      "enum": [
        "adjacent_context",
        "multi_benefit",
        "supporting_table_source"
      ]
    },
    "routingEvidence": {
      "type": "object",
      "required": ["kind", "source", "field"],
      "properties": {
        "kind": {
          "enum": ["taxonomy_field", "document_metadata", "content_keyword"]
        },
        "source": {
          "enum": ["manifest_document", "source_catalog", "markdown_excerpt"]
        },
        "field": { "type": "string", "minLength": 1 },
        "value": {},
        "quote": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "content_keyword" }
            }
          },
          "then": {
            "required": ["quote"],
            "not": { "required": ["value"] }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["taxonomy_field", "document_metadata"]
              }
            }
          },
          "then": {
            "required": ["value"],
            "not": { "required": ["quote"] }
          }
        }
      ],
      "additionalProperties": false
    },
    "documentRoute": {
      "type": "object",
      "required": [
        "document_id",
        "source_catalog_id",
        "product_name",
        "region_family",
        "jurisdiction",
        "product_class_primary",
        "product_class_secondary",
        "routing_confidence",
        "classification_mode",
        "skill_pack_hint",
        "routing_flags",
        "routing_evidence"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1
        },
        "source_catalog_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1
        },
        "product_name": { "type": "string", "minLength": 1 },
        "region_family": { "enum": ["north_america"] },
        "jurisdiction": { "enum": ["CA"] },
        "product_class_primary": { "$ref": "#/$defs/primaryClass" },
        "product_class_secondary": {
          "type": "array",
          "items": { "$ref": "#/$defs/secondaryTag" },
          "uniqueItems": true
        },
        "routing_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "classification_mode": {
          "enum": ["manifest_precedence", "source_catalog_fallback"]
        },
        "skill_pack_hint": {
          "type": "string",
          "pattern": "^north_america\\/[a-z_]+$"
        },
        "routing_flags": {
          "type": "array",
          "items": { "$ref": "#/$defs/routingFlag" },
          "uniqueItems": true
        },
        "routing_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/routingEvidence" }
        },
        "routing_warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "pairedSourceScenarioRoute": {
      "type": "object",
      "required": [
        "scenario_id",
        "product_name",
        "relation",
        "fixture_ids",
        "source_catalog_ids",
        "product_class_primary",
        "product_class_secondary",
        "routing_implication",
        "rationale"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1
        },
        "product_name": { "type": "string", "minLength": 1 },
        "relation": {
          "enum": ["complementary", "known_overlap", "potentially_contradictory"]
        },
        "fixture_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_catalog_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "product_class_primary": { "$ref": "#/$defs/primaryClass" },
        "product_class_secondary": {
          "type": "array",
          "items": { "$ref": "#/$defs/secondaryTag" },
          "uniqueItems": true
        },
        "routing_implication": {
          "enum": [
            "cross_reference_same_product_sources",
            "reconcile_overlapping_same_product_evidence",
            "escalate_same_product_source_disagreements"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
