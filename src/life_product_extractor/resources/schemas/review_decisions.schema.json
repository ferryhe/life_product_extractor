{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/review_decisions.schema.json",
  "title": "ReviewDecisionsV0_1",
  "type": "object",
  "required": ["schema_version", "candidate_fixture_set_id", "reviewer", "decisions"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "candidate_fixture_set_id": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "decision"],
        "properties": {
          "path": { "type": "string", "pattern": "^/products/[0-9]+/(decrements|benefits|explicit_unknowns)/[0-9]+$" },
          "decision": { "type": "string", "enum": ["reviewed", "needs_human_review", "blocked"] },
          "reviewer_note": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
