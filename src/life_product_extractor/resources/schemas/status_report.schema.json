{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/status_report.schema.json",
  "title": "StatusReport",
  "type": "object",
  "required": ["schema_version", "run_id", "fixture_set_id", "source", "summary", "blockers"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "fixture_set_id": { "type": "string", "minLength": 1 },
    "source": { "enum": ["run_artifacts", "reviewed"] },
    "summary": {
      "type": "object",
      "required": [
        "status",
        "model_ready",
        "product_count",
        "unsupported_document_count",
        "needs_human_review_count",
        "blocked_count"
      ],
      "properties": {
        "status": { "enum": ["ready", "needs_human_review", "blocked"] },
        "model_ready": { "type": "boolean" },
        "product_count": { "type": "integer", "minimum": 0 },
        "unsupported_document_count": { "type": "integer", "minimum": 0 },
        "needs_human_review_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "message"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
