{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/reviewed_product.schema.json",
  "title": "ReviewedProductBundleV0_1",
  "allOf": [
    { "$ref": "candidate_bundle.schema.json" },
    {
      "type": "object",
      "required": ["review_metadata"],
      "properties": {
        "review_metadata": {
          "type": "object",
          "required": ["schema_version", "source", "run_id", "reviewer", "decisions_applied"],
          "properties": {
            "schema_version": { "const": "0.1" },
            "source": { "const": "review_decisions" },
            "run_id": { "type": "string", "minLength": 1 },
            "reviewer": { "type": "string", "minLength": 1 },
            "decisions_applied": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "decision"],
                "properties": {
                  "path": { "type": "string", "pattern": "^/products/[0-9]+/(decrements|benefits|explicit_unknowns)/[0-9]+$" },
                  "decision": { "type": "string", "enum": ["reviewed", "needs_human_review", "blocked"] }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  ]
}
