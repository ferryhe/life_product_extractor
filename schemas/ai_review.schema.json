{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/ai_review.schema.json",
  "title": "AIReview",
  "type": "object",
  "required": ["run_id", "reviewer", "summary", "field_reviews"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "reviewer": {
      "type": "object",
      "required": ["type", "skillpack", "version"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "skillpack": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["ai_accepted_count", "needs_human_review_count", "blocked_count"],
      "properties": {
        "ai_accepted_count": { "type": "integer", "minimum": 0 },
        "needs_human_review_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "field_reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fieldReview" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "fieldReview": {
      "type": "object",
      "required": ["path", "decision", "materiality", "reason_code", "rationale"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "decision": {
          "type": "string",
          "enum": ["ai_accepted", "needs_human_review", "blocked"]
        },
        "materiality": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "reason_code": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "required_human_action": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": { "const": "needs_human_review" }
            },
            "required": ["decision"]
          },
          "then": {
            "required": ["required_human_action"]
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
