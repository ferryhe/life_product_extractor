{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/candidate_bundle.schema.json",
  "title": "CandidateBundleV0_1",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_set_id",
    "extraction_strategy",
    "summary",
    "products",
    "unsupported_documents"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "fixture_set_id": { "type": "string", "minLength": 1 },
    "extraction_strategy": {
      "type": "object",
      "required": ["deterministic", "supported_product_classes", "supported_fixture_ids"],
      "properties": {
        "deterministic": { "const": true },
        "supported_product_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "supported_fixture_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["product_count", "supported_document_count", "unsupported_document_count"],
      "properties": {
        "product_count": { "type": "integer", "minimum": 0 },
        "supported_document_count": { "type": "integer", "minimum": 0 },
        "unsupported_document_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "products": {
      "type": "array",
      "items": { "$ref": "candidate_product.schema.json" }
    },
    "unsupported_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "product_name", "product_class_primary", "reason"],
        "properties": {
          "document_id": { "type": "string", "minLength": 1 },
          "product_name": { "type": "string", "minLength": 1 },
          "product_class_primary": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
