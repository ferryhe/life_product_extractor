{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/routing.schema.json",
  "title": "Routing",
  "type": "object",
  "required": ["document_id", "region_family", "product_class_primary", "product_class_secondary", "confidence"],
  "properties": {
    "document_id": { "type": "string" },
    "region_family": { "type": "string" },
    "product_class_primary": { "type": "string" },
    "product_class_secondary": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
