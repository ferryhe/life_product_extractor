{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/manifest.schema.json",
  "title": "Manifest",
  "type": "object",
  "required": ["document_id", "markdown_path", "source_url"],
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "markdown_path": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "source_file_sha256": { "type": "string" },
    "document_type": { "type": "string" },
    "audience": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "language": { "type": "string" },
    "product_hint": { "type": "string" },
    "conversion_quality": { "type": "string" }
  },
  "additionalProperties": true
}
