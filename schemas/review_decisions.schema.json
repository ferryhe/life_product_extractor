{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/review_decisions.schema.json",
  "title": "ReviewDecisionsV0_1",
  "type": "object",
  "required": ["schema_version", "decisions"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "decision"],
        "properties": {
          "path": { "type": "string" },
          "decision": { "type": "string", "enum": ["accept", "reject", "edit", "needs_follow_up"] },
          "reviewer_note": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
