{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferryhe.github.io/life_product_extractor/schemas/sections_structured.schema.json",
  "title": "StructuredSections",
  "type": "object",
  "required": ["document_id", "sections"],
  "properties": {
    "document_id": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "heading", "source_quote"],
        "properties": {
          "section_id": { "type": "string" },
          "heading": { "type": "string" },
          "source_quote": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
